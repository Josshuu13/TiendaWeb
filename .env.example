# Copia este archivo como .env y llena lo que necesites. .env nunca se sube a Git.
# Para desarrollar no hace falta ninguna variable: todo tiene un valor por defecto.

# --- Stripe en modo de pruebas (dashboard.stripe.com/test/apikeys) ---
# Sin estas llaves, en desarrollo se usa el pago simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Producción ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=una-clave-larga-y-secreta
# DJANGO_ALLOWED_HOSTS=mi-tienda.onrender.com
# DATABASE_URL=postgres://usuario:clave@host:5432/pretexto

# --- Correo real (opcional; por defecto se imprime en la terminal) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Pretexto <hola@tudominio.com>
